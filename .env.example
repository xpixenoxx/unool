# Supabase (REQUIRED - get from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Encryption Key (REQUIRED - generate: openssl rand -base64 32)
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# Upstash QStash (REQUIRED - get from https://console.upstash.com/qstash)
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis (REQUIRED - get from https://console.upstash.com/redis)
UPSTASH_REDIS_REST_URL=https://ready-sunfish-xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API (REQUIRED - get from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_MODEL=claude-sonnet-5
AI_DEFAULT_MODEL=claude-sonnet-5

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-proj-xxx
AI_OPENAI_MODEL=gpt-4o-mini

# OAuth: LinkedIn (get from https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Production: https://unool.co/api/auth/platform/callback
# Local: http://localhost:3000/api/auth/platform/callback
LINKEDIN_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# OAuth: X/Twitter (get from https://developer.twitter.com/en/portal/dashboard)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# OAuth: Threads (get from https://developers.facebook.com/apps/)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# Webhook Secrets (generate random strings)
LINKEDIN_WEBHOOK_SECRET=
X_WEBHOOK_SECRET=
META_WEBHOOK_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Instagram OAuth (get from https://developers.facebook.com/apps/)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://unool.co/api/auth/platform/callback
# Webhook verify token — set the same value in Meta Developer Console → Webhooks → Verify Token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Groq API (for Instagram comment automation - get from https://console.groq.com/)
GROQ_API_KEY=

# Cron secret — passed as Authorization: Bearer <value> by external cron callers
# Not required if using Vercel Cron (Vercel calls cron routes directly)
CRON_SECRET=

# Mastodon (If using a single dedicated instance OAuth flow. For standard Unool PAT flow, these are unused)
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# Discord OAuth (get from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# Kick OAuth (get from https://kick.com/dashboard/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# VK (VKontakte) OAuth (get from https://dev.vk.ru/)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
VK_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# MeWe Developer API (get from https://mewe.com/developer or https://dev.mewe.com)
MEWE_CLIENT_ID=
MEWE_APP_ID=
MEWE_API_KEY=
MEWE_CLIENT_SECRET=
MEWE_REDIRECT_URI=https://unool.co/api/auth/platform/callback

# App
NEXT_PUBLIC_APP_URL=https://unool.co
DEV_AUTH_BYPASS=false

# Sentry (optional - for production error tracking)
SENTRY_DSN=

# Rate Limits
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_PUBLISH_PER_MIN=10
RATE_LIMIT_AUTH_PER_HOUR=5
AI_MAX_TOKENS_PER_REQUEST=4000
AI_DAILY_TOKEN_BUDGET=50000

# ─── Cloudflare R2 Storage (replaces Supabase Storage) ────────────────────────
# 1. Go to Cloudflare Dashboard → R2 → Overview → Manage R2 API Tokens
# 2. Create a token with Object Read & Write permissions
# 3. Create TWO buckets:  post-media   and   avatars
# 4. Make them public: R2 bucket → Settings → Public Access → Allow Access
#
# CF_R2_ACCOUNT_ID   → Cloudflare Dashboard → right sidebar "Account ID"
# CF_R2_ACCESS_KEY_ID, CF_R2_SECRET_ACCESS_KEY → from the API token you created
CF_R2_ACCOUNT_ID=your-account-id
CF_R2_ACCESS_KEY_ID=your-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-secret-access-key

# Bucket Names
CF_R2_MEDIA_BUCKET_NAME=post-media
CF_R2_AVATARS_BUCKET_NAME=avatars

# Public URLs — get from R2 bucket → Settings → Public Access
# Example: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
CF_R2_MEDIA_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
CF_R2_AVATARS_PUBLIC_URL=https://pub-yyyyyyyyyyyyyyyy.r2.dev

# ──────────────────────────────────────────────────────────────────
# Cashfree Payment Gateway
# Get keys from: https://merchant.cashfree.com/developers/pg/api-keys
# ──────────────────────────────────────────────────────────────────
# App ID (x-client-id) — never expose to client
CASHFREE_APP_ID=
# Secret Key (x-client-secret) — never expose to client
CASHFREE_SECRET_KEY=
# Webhook Secret — from Cashfree Dashboard → Webhooks → Secret Key
CASHFREE_WEBHOOK_SECRET=
# Sandbox: https://sandbox.cashfree.com/pg
# Production: https://api.cashfree.com/pg
CASHFREE_API_URL=https://sandbox.cashfree.com/pg
CASHFREE_MODE=sandbox
# Client-side mode flag (NEXT_PUBLIC so it reaches the browser SDK)
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# ──────────────────────────────────────────────────────────────────
# Vercel API (for custom domain management — Pro/Studio plans)
# Get token from: https://vercel.com/account/tokens
# ──────────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only required if using a Vercel Team
# VERCEL_TEAM_ID=
